#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE    0
#define NUMNAV  1
#define NUMLOCK 2   // locked copy of NUMNAV; survives releasing the thumb
#define SYM     3
#define FN      4

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
    quick-tap-ms = <0>;
};

// Thumb layer-taps: another key pressed while held -> layer; tap-then-hold -> repeat
&lt {
    tapping-term-ms = <200>;
    flavor = "balanced";
    quick-tap-ms = <175>;
};

/ {
    combos {
        compatible = "zmk,combos";
        combo_caps {
            timeout-ms = <75>;
            key-positions = <14 21>;
            bindings = <&caps_word>;
        };
        combo_tab {
            timeout-ms = <50>;
            key-positions = <1 2>;          // Q + W
            require-prior-idle-ms = <150>;  // remove if your ZMK version rejects it
            bindings = <&kp TAB>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <NUMNAV SYM>;
            then-layer = <FN>;
        };
        tri_layer_locked {
            if-layers = <NUMLOCK SYM>;
            then-layer = <FN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
   &none &kp Q        &kp W       &kp E       &kp R       &kp T        &kp Y  &kp U       &kp I       &kp O        &kp P          &none
   &none &mt LSHFT A  &mt LCTRL S &mt LALT D  &mt LGUI F  &kp G        &kp H  &mt RGUI J  &mt RALT K  &mt RCTRL L  &mt RSHFT SQT  &none
   &none &kp Z        &kp X       &kp C       &kp V       &kp B        &kp N  &kp M       &kp COMMA   &kp DOT      &kp FSLH       &none
                       &none &lt NUMNAV ESC &lt SYM RET        &lt SYM SPACE &lt NUMNAV BSPC &none
            >;
        };

        num_nav {
            bindings = <
   &none &kp ASTRK        &kp N7        &kp N8       &kp N9       &kp FSLH     &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp DEL &none
   &none &mt LSHFT MINUS  &mt LCTRL N4  &mt LALT N5  &mt LGUI N6  &kp PLUS     &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans  &none
   &none &kp BSPC         &kp N1        &kp N2       &kp N3       &kp EQUAL    &kp N0    &kp DOT   &trans    &trans    &tog NUMLOCK &none
                       &none &lt NUMNAV ESC &lt SYM RET        &lt SYM SPACE &lt NUMNAV BSPC &none
            >;
        };

        // Identical to num_nav. Kept as its own layer so the lock isn't cleared
        // when the Esc/Bksp hold is released. Edit both layers together.
        num_lock {
            bindings = <
   &none &kp ASTRK        &kp N7        &kp N8       &kp N9       &kp FSLH     &kp HOME  &kp PG_DN &kp PG_UP &kp END   &kp DEL &none
   &none &mt LSHFT MINUS  &mt LCTRL N4  &mt LALT N5  &mt LGUI N6  &kp PLUS     &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &trans  &none
   &none &kp BSPC         &kp N1        &kp N2       &kp N3       &kp EQUAL    &kp N0    &kp DOT   &trans    &trans    &tog NUMLOCK &none
                       &none &lt NUMNAV ESC &lt SYM RET        &lt SYM SPACE &lt NUMNAV BSPC &none
            >;
        };

        sym {
            bindings = <
   &none  &kp PRCNT  &kp CARET &kp AMPS  &kp DLLR  &none         &none     &kp COLON &kp ASTRK &kp LBKT  &kp RBKT &none
   &none  &kp GRAVE  &kp BSLH  &kp LBRC  &kp RBRC  &kp QMARK     &kp MINUS &kp EQUAL &kp LPAR  &kp RPAR  &kp SEMI &none
   &none  &kp TILDE  &kp PIPE  &kp EXCL  &kp AT    &kp HASH      &kp UNDER &kp PLUS  &kp LT    &kp GT    &kp DQT  &none
                       &none &lt NUMNAV ESC &lt SYM RET        &lt SYM SPACE &lt NUMNAV BSPC &none
            >;
        };

        fn {
            bindings = <
   &none &kp F10    &kp F7        &kp F8       &kp F9       &kp F11      &kp C_MUTE    &kp C_PP      &kp C_BRI_DN  &kp C_BRI_UP  &none      &none
   &none &kp LSHFT  &mt LCTRL F4  &mt LALT F5  &mt LGUI F6  &kp F12      &kp C_PREV    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_NEXT    &none      &none
   &none &none      &kp F1        &kp F2       &kp F3       &none        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_CLR &none
                       &none &lt NUMNAV ESC &lt SYM RET        &lt SYM SPACE &lt NUMNAV BSPC &none
            >;
        };
    };
};
